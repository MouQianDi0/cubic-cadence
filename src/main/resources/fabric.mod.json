{
	"schemaVersion": 1,
	"id": "cubic-cadence",
	"version": "${version}",
	"name": "Cubic Cadence",
	"description": "A Minecraft Fabric client music mod for NetEase Cloud Music.",
	"authors": [
		"Cubic Cadence"
	],
	"license": "CC0-1.0",
	"icon": "assets/cubic-cadence/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.cubiccadence.client.CubicCadenceClient"
		]
	},
	"mixins": [
		{
			"config": "cubic-cadence.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
